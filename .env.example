# Norma Jurídica - Modelo de Variáveis de Ambiente (NUNCA versione .env ou .dev.vars reais)

# Gemini AI (uso exclusivo no servidor)
GEMINI_API_KEY=""

# Domínio e URLs do Portal
APP_URL="https://normajuridica.com.br"
SITE_DOMAIN="normajuridica.com.br"
NEXT_PUBLIC_SITE_URL="https://normajuridica.com.br"

# Armazenamento Persistente Local (SQLite / better-sqlite3)
NEWS_SQLITE_PATH="./data/news.db"
NEWS_STORE_MAX_ITEMS=15000
NEWS_STORE_MAX_PER_SOURCE=350
NEWS_RETENTION_DAYS=90
NEWS_SYNC_INTERVAL_SECONDS=60

# Google AdSense (IDs públicos de exibição)
NEXT_PUBLIC_ADSENSE_ID=""
NEXT_PUBLIC_ADSENSE_SLOT_HEADER=""
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=""
NEXT_PUBLIC_ADSENSE_SLOT_FOOTER=""
GOOGLE_ADSENSE_CLIENT_ID=""
GOOGLE_ADSENSE_SLOT_HEADER=""
GOOGLE_ADSENSE_SLOT_SIDEBAR=""
GOOGLE_ADSENSE_SLOT_SIDEBAR_BOTTOM=""
GOOGLE_ADSENSE_SLOT_IN_ARTICLE=""
GOOGLE_ADSENSE_SLOT_FOOTER=""

# Fonte de Notícias (secrets de autenticação exclusivos de servidor/runtime — nunca usar prefixo NEXT_PUBLIC_)
NEWS_API_BASE_URL="https://news-sources-api.legislativemunicipal.workers.dev"
API_KEY=""
NEWS_API_KEY=""

# Previsão do Tempo & Alertas INMET (API pública sem chave de API ou senha)
WEATHER_API_BASE_URL="https://radarmeteorologico.com.br"
WEATHER_BASE_URL="https://radarmeteorologico.com.br"
NEXT_PUBLIC_WEATHER_API_BASE_URL="https://radarmeteorologico.com.br"

# Leitura de Artigo em Áudio (secrets exclusivos de servidor/runtime)
ELEVENLABS_API_KEY=""
ELEVENLABS_API_URL=""
ELEVENLABS_VOICE_ID=""

# Resumo por Inteligência Artificial (secrets exclusivos de servidor/runtime)
AI_SUMMARY_API_ENDPOINT=""
AI_SUMMARY_API_KEY=""
AI_SUMMARY_MODEL=""

# Atendimento e Envio de E-mail (SMTP — secrets exclusivos de servidor/runtime)
SMTP_HOST=""
SMTP_PORT=""
SMTP_SECURE=""
SMTP_USER=""
SMTP_PASS=""
CONTACT_RECEIVER_EMAIL=""

# Revalidação, Sincronização Administrativa e Cron (obrigatório em produção)
REVALIDATE_SECRET=""
CRON_SECRET=""

# Cloudflare Workers (configurar exclusivamente via `wrangler secret put`)
ORIGIN_URL=""
CONTACT_WEBHOOK_URL=""
