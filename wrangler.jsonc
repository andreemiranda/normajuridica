{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "normajuridica",
  "main": "worker.js",
  "compatibility_date": "2025-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": false,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issue_detection": {
      "enabled": true
    }
  },
  // Sem "routes" aqui, de propósito: declarar o custom domain no arquivo causava o erro de deploy [code: 10082].
  // O domínio https://normajuridica.com.br deve ser vinculado ao worker "normajuridica" pelo painel da Cloudflare
  // (Workers & Pages > normajuridica > Settings > Domains & Routes), com a zona na mesma conta.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  "triggers": {
    "crons": ["* * * * *"]
  },
  // Apenas variáveis públicas não-sensíveis.
  // Segredos (API_KEY, NEWS_API_KEY, ELEVENLABS_API_KEY, REVALIDATE_SECRET, CRON_SECRET, ORIGIN_URL)
  // devem ser cadastrados exclusivamente via `wrangler secret put <NOME>` ou painel Cloudflare.
  "vars": {
    "NODE_ENV": "production",
    "CLOUDFLARE_WORKER": "true",
    "APP_URL": "https://normajuridica.com.br",
    "SITE_DOMAIN": "normajuridica.com.br",
    "NEXT_PUBLIC_SITE_URL": "https://normajuridica.com.br",
    "NEWS_API_BASE_URL": "https://news-sources-api.legislativemunicipal.workers.dev",
    "WEATHER_API_BASE_URL": "https://radarmeteorologico.com.br",
    "WEATHER_BASE_URL": "https://radarmeteorologico.com.br",
    "NEXT_PUBLIC_WEATHER_API_BASE_URL": "https://radarmeteorologico.com.br",
    "NEXT_PUBLIC_ADSENSE_ID": "ca-pub-7059730627018047",
    "NEXT_PUBLIC_ADSENSE_SLOT_FOOTER": "7613698536",
    "NEXT_PUBLIC_ADSENSE_SLOT_HEADER": "2112796122",
    "NEXT_PUBLIC_ADSENSE_SLOT_IN_ARTICLE": "6400171558",
    "NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR": "1127017514",
    "NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR_BOTTOM": "8465515707",
    "GOOGLE_ADSENSE_CLIENT_ID": "ca-pub-7059730627018047",
    "GOOGLE_ADSENSE_SLOT_FOOTER": "7613698536",
    "GOOGLE_ADSENSE_SLOT_HEADER": "2112796122",
    "GOOGLE_ADSENSE_SLOT_IN_ARTICLE": "6400171558",
    "GOOGLE_ADSENSE_SLOT_SIDEBAR": "1127017514",
    "GOOGLE_ADSENSE_SLOT_SIDEBAR_BOTTOM": "8465515707"
  }
}
